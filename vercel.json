{
  "functions": {
    "src/server/routes/feed.xml.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/images/(.*)",
      "destination": "/src/public/images/$1"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}

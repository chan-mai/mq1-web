{
	"name": "mq1-web",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm sync:takumi-wasm && nuxt build",
		"build:workers": "pnpm sync:takumi-wasm && cross-env NITRO_PRESET=cloudflare-module nuxt build --preset=cloudflare-module",
		"sync:takumi-wasm": "node -e \"require('node:fs').copyFileSync('node_modules/@takumi-rs/wasm/pkg/takumi_wasm_bg.wasm', 'server/assets/takumi.wasm')\"",
		"check:worker-wasm": "tsx scripts/check-worker-wasm.ts",
		"dev": "cross-env NUXT_HOST=0.0.0.0 NUXT_PORT=3000 nuxt dev",
		"d1:migrate:local": "pnpm exec wrangler d1 migrations apply mq1-web-prod --local",
		"d1:migrate:remote": "pnpm exec wrangler d1 migrations apply mq1-web-prod --remote",
		"deploy:workers": "pnpm build:workers && pnpm check:worker-wasm && pnpm exec wrangler deploy",
		"deploy:workers:dry": "pnpm exec wrangler deploy --dry-run",
		"generate": "nuxt generate",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"preview": "nuxt preview",
		"start": "node .output/server/index.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "nuxi typecheck",
		"postinstall": "nuxt prepare"
	},
	"dependencies": {
		"@nuxt/icon": "2.6.3",
		"@nuxt/image": "2.2.1",
		"@nuxt/scripts": "^1.3.12",
		"@nuxtjs/critters": "^0.10.1",
		"@nuxtjs/robots": "7.0.2",
		"@nuxtjs/sitemap": "9.1.0",
		"@nuxtjs/tailwindcss": "6.14.0",
		"@takumi-rs/helpers": "2.22.1",
		"@takumi-rs/wasm": "2.22.1",
		"@tiptap/core": "^3.35.0",
		"@tiptap/extension-code-block": "^3.35.0",
		"@tiptap/extension-heading": "^3.35.0",
		"@tiptap/extension-table": "^3.35.0",
		"@tiptap/extensions": "^3.35.0",
		"@tiptap/html": "^3.35.0",
		"@tiptap/pm": "^3.35.0",
		"@tiptap/starter-kit": "^3.35.0",
		"@tiptap/vue-3": "^3.35.0",
		"@vite-pwa/nuxt": "^2.0.2",
		"@vueuse/core": "^15.0.0",
		"@vueuse/nuxt": "15.0.0",
		"bcryptjs": "^3.0.3",
		"cheerio": "^1.2.0",
		"cross-env": "^10.1.0",
		"diff": "^9.0.0",
		"dotenv": "^18.0.10",
		"drizzle-orm": "^0.45.4",
		"feed": "^6.0.0",
		"gsap": "^3.15.1",
		"highlight.js": "^11.12.0",
		"idb": "^8.0.4",
		"kiso.css": "^1.2.4",
		"marked": "^18.2.1",
		"mermaid": "^12.3.0",
		"microcms-js-sdk": "^3.6.0",
		"nanoid": "^6.0.2",
		"nuxt": "^4.6.4",
		"nuxt-jsonld": "^3.0.0",
		"oauth4webapi": "^3.8.9",
		"pg": "^8.23.1",
		"three": "^0.187.0",
		"tsx": "^4.23.15",
		"uuid": "^14.0.3",
		"valibot": "^1.5.0",
		"vue": "^3.5.46",
		"vue-boring-avatars": "^1.4.0",
		"vue-router": "^5.5.1"
	},
	"devDependencies": {
		"@chan-mai/oxc-config": "^1.3.0",
		"@cloudflare/workers-types": "^5.20261120.1",
		"@iconify-json/line-md": "^1.2.16",
		"@iconify-json/lucide": "^1.2.157",
		"@iconify-json/material-symbols": "^1.2.101",
		"@iconify-json/simple-icons": "^1.2.103",
		"@nuxtjs/color-mode": "^4.1.0",
		"@types/pg": "^8.23.1",
		"@types/three": "^0.187.0",
		"nitro-cloudflare-dev": "^0.2.2",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"oxlint-tsgolint": "^7.0.2007",
		"typescript": "^6.0.3",
		"unwasm": "0.6.3",
		"vitest": "^5.1.1",
		"vue-tsc": "^3.3.14",
		"workbox-build": "^7.4.1",
		"workbox-window": "^7.4.1",
		"wrangler": "^4.166.0"
	},
	"packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}

{
  "name": "mq1-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build:workers": "cross-env NITRO_PRESET=cloudflare-module nuxt build --preset=cloudflare-module",
    "check:worker-wasm": "tsx scripts/check-worker-wasm.ts",
    "dev": "cross-env NUXT_HOST=0.0.0.0 NUXT_PORT=3000 nuxt dev",
    "d1:migrate:local": "pnpm exec wrangler d1 migrations apply mq1-web-prod --local",
    "d1:migrate:remote": "pnpm exec wrangler d1 migrations apply mq1-web-prod --remote",
    "d1:import:cockroach": "tsx scripts/migrate-cockroach-to-d1.ts",
    "cms:migrate:images": "tsx scripts/migrate-microcms-images.ts",
    "cms:migrate:seed": "tsx scripts/migrate-microcms-to-d1.ts",
    "deploy:workers": "pnpm build:workers && pnpm check:worker-wasm && pnpm exec wrangler deploy",
    "deploy:workers:dry": "pnpm exec wrangler deploy --dry-run",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxi typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/icon": "2.5.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "^1.3.11",
    "@nuxtjs/critters": "^0.10.1",
    "@nuxtjs/robots": "6.2.4",
    "@nuxtjs/sitemap": "8.6.1",
    "@nuxtjs/tailwindcss": "6.14.0",
    "@takumi-rs/helpers": "2.14.0",
    "@takumi-rs/wasm": "2.14.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-code-block": "^3.31.4",
    "@tiptap/extension-heading": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/html": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cross-env": "^10.1.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "feed": "^6.0.0",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.3",
    "kiso.css": "^1.2.4",
    "marked": "^18.0.14",
    "mermaid": "^12.1.0",
    "microcms-js-sdk": "^3.5.1",
    "nanoid": "^6.0.1",
    "nuxt": "^4.5.2",
    "nuxt-jsonld": "^2.3.0",
    "oauth4webapi": "^3.8.8",
    "pg": "^8.23.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2",
    "valibot": "^1.5.0",
    "vue": "^3.5.43",
    "vue-boring-avatars": "^1.4.0",
    "vue-router": "^5.3.1"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@eslint/js": "^10.0.1",
    "@iconify-json/line-md": "^1.2.16",
    "@iconify-json/lucide": "^1.2.138",
    "@iconify-json/material-symbols": "^1.2.93",
    "@iconify-json/simple-icons": "^1.2.98",
    "@nuxtjs/color-mode": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "unwasm": "0.6.0",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.147.0"
  }
}

{
  "regions": ["hnd1"],
  "buildCommand": "prisma generate && pnpm prisma db push && pnpm build",
  "installCommand": "pnpm install",
  "rewrites": [
    {
      "source": "/images/(.*)",
      "destination": "/src/public/images/$1"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
